        "holder": "visual",
        "cell": "visual",
        "bms": "visual",
        "usb_c_charger": "visual",
        "battery_pack_lid": "visual",
        "right_eye": "visual",
        "left_eye": "visual",
        "glass": "visual",
        "full_speaker": "visual",
        "roll_bearing": "visual",
        "power_switch": "visual",
        "board": "visual",
        "bno055": "visual",
